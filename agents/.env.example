# OpenAI Compatible API settings

OPENAI_COMPATIBLE_API_KEY=your_openai_compatible_api_key
OPENAI_COMPATIBLE_BASE_URL=your_base_url
OPENAI_COMPATIBLE_MODEL=your_model_name
USE_LOCAL_MODEL=api

# LangSmith（可选）：Python SDK 维护仓库为 langchain-ai/langsmith-python。
# 填好 Key 和下方目标后设为 true；默认不上传。修改后重启服务。
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Project-based workspace:
LANGSMITH_PROJECT=finex-dev
# Agent-based workspace：先在 LangSmith 创建 agent，复制标识符；注释掉上面的 PROJECT。
# LANGSMITH_AGENT_ID=finex
# LANGSMITH_AGENT_ENVIRONMENT=development
# 组织级 Key 需要时填写目标 workspace ID。
# LANGSMITH_WORKSPACE_ID=
# 调试期采样全部；上线后可调低。按整条 trace 采样，范围 0 到 1。
LANGSMITH_TRACING_SAMPLING_RATE=1
# 如需隐藏提示词/输出，可开启；将影响云端排障时可见的正文。
# LANGSMITH_HIDE_INPUTS=true
# LANGSMITH_HIDE_OUTPUTS=true

# 汇总专用输出 token 上限（含供应商计入预算的推理 token）；与四路分析独立。
# 需符合所选模型/供应商支持的上限。修改后重启服务。
SUMMARY_MAX_TOKENS=12000

# MCP 普通工具 / 综合查询预算（秒）；排队另受分析总预算约束。
MCP_TOOL_TIMEOUT_SECONDS=45
MCP_COMPOSITE_TOOL_TIMEOUT_SECONDS=180
# 四路分析总预算，包含模型调用、工具排队与执行。
REACT_TIMEOUT_SECONDS=480
ANALYSIS_TOOL_CALL_LIMIT=12
ANALYSIS_FINAL_RESERVE_SECONDS=90
# 每日实际 SDK 发包（含登录、登出、分页），按北京时间自然日跨进程计数。
# 同一出口的部署应共用 FINEX_BAOSTOCK_STATE_DIR；其他机器需统一调度。
BAOSTOCK_DAILY_REQUEST_LIMIT=45000

# PDF: 默认自动发现项目 .tools/pdf 中的工具或 PATH 中的 Pandoc 3 / XeLaTeX / Tectonic。
# 首次使用 Tectonic 时需要联网下载 LaTeX 包，之后使用本地缓存。
# PANDOC_PATH=C:/path/to/pandoc.exe
# PDF_LATEX_ENGINE=tectonic
# Windows 默认 Microsoft YaHei，其他平台默认 FandolHei-Regular.otf。
# PDF_CJK_FONT=Noto Sans CJK SC
PDF_TIMEOUT_SECONDS=300

# BaoStock 黑名单本地暂停期限（秒，至少 60）；默认 6 小时，无法替代官方解封。
BAOSTOCK_BLACKLIST_COOLDOWN_SECONDS=21600
# 默认项目根目录 .runtime/baostock；同机多副本需设置相同的绝对路径。
# FINEX_BAOSTOCK_STATE_DIR=E:/shared/finex-baostock
