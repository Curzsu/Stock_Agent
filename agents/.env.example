# OpenAI Compatible API settings

OPENAI_COMPATIBLE_API_KEY=your_openai_compatible_api_key
OPENAI_COMPATIBLE_BASE_URL=your_base_url
OPENAI_COMPATIBLE_MODEL=your_model_name
USE_LOCAL_MODEL=api

# 汇总专用输出 token 上限（含供应商计入预算的推理 token）；与四路分析独立。
# 需符合所选模型/供应商支持的上限。修改后重启服务。
SUMMARY_MAX_TOKENS=12000

# PDF: 默认自动发现项目 .tools/pdf 中的工具或 PATH 中的 Pandoc 3 / XeLaTeX / Tectonic。
# 首次使用 Tectonic 时需要联网下载 LaTeX 包，之后使用本地缓存。
# PANDOC_PATH=C:/path/to/pandoc.exe
# PDF_LATEX_ENGINE=tectonic
# Windows 默认 Microsoft YaHei，其他平台默认 FandolHei-Regular.otf。
# PDF_CJK_FONT=Noto Sans CJK SC
PDF_TIMEOUT_SECONDS=300

# BaoStock 黑名单本地暂停期限（秒，至少 60）；默认 6 小时，无法替代官方解封。
BAOSTOCK_BLACKLIST_COOLDOWN_SECONDS=21600
# 默认项目根目录 .runtime/baostock；同机多副本需设置相同的绝对路径。
# FINEX_BAOSTOCK_STATE_DIR=E:/shared/finex-baostock
