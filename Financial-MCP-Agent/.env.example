# OpenAI Compatible API settings

OPENAI_COMPATIBLE_API_KEY=your_openai_compatible_api_key
OPENAI_COMPATIBLE_BASE_URL=your_base_url
OPENAI_COMPATIBLE_MODEL=your_model_name
USE_LOCAL_MODEL=api

# Summary Agent 专用 GGUF 模型配置 (当 SUMMARY_MODEL_TYPE=gguf 时生效)
SUMMARY_MODEL_TYPE=gguf
GGUF_MODEL_PATH=/path/to/your/model.gguf
GGUF_N_CTX=8192
GGUF_N_GPU_LAYERS=0
GGUF_N_THREADS=8